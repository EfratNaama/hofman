rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isLoggedIn() {
      return request.auth != null;
    }

    // Missing status preserves legacy access; explicit inactive always denies it.
    function isActiveUser() {
      return isLoggedIn() && (!userDocExists()
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', '') != 'inactive');
    }

    function isOwner(userId) {
      return isLoggedIn() && request.auth.uid == userId;
    }

    function userDocExists() {
      return isLoggedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return userDocExists()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    match /users/{userId} {
      // Own profile remains readable so inactive sessions can detect revocation.
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if (
          isAdmin()
          && request.resource.data.uid == userId
          && request.resource.data.role in ['resident', 'volunteer', 'admin']
        ) || (isOwner(userId)
          && request.resource.data.get('role', '') == ''
          && request.resource.data.get('status', '') in ['', 'active']);
      allow update: if isAdmin()
        || (
          isOwner(userId)
          && isActiveUser()
          && request.resource.data.get('role', '') == resource.data.get('role', '')
          && request.resource.data.get('status', '') == resource.data.get('status', '')
        );
      allow delete: if isAdmin();
    }

    match /activities/{activityId} {
      allow read: if isActiveUser();
      allow create, update, delete: if isAdmin();
    }

    match /activityRegistrations/{registrationId} {
      allow get: if isAdmin()
        || (
          isActiveUser()
          && registrationId.matches(request.auth.uid + '_.*')
        );
      allow list: if isActiveUser();
      allow create: if isActiveUser()
        && request.resource.data.userId == request.auth.uid
        && registrationId == request.auth.uid + '_' + request.resource.data.activityId
        && request.resource.data.get('paymentStatus', 'pending') == 'pending';
      allow update: if (
          isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paymentStatus'])
          && request.resource.data.paymentStatus in ['pending', 'paid']
        ) || (
          isActiveUser()
          && resource.data.userId == request.auth.uid
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['paymentStatus', 'userId', 'activityId'])
        );
      allow delete: if isAdmin()
        || (isActiveUser() && resource.data.userId == request.auth.uid);
    }

    match /gallery/{galleryItemId} {
      allow read: if isActiveUser();
      allow create, update, delete: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /center_info/{centerInfoId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
